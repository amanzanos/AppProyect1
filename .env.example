# Firebase — Firestore + autenticación anónima. Plan gratuito (Spark) de sobra.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Anuncios. Sin esto a "1" no se carga nada de AdMob en ningún sitio.
NEXT_PUBLIC_ADS_ENABLED=0
# Deja "1" hasta que la app esté aprobada: pulsar tus propios anuncios reales
# es la forma más rápida de que Google cierre la cuenta de AdMob.
NEXT_PUBLIC_ADS_TEST=1
# Vacíos = unidades de prueba de Google, que siempre muestran algo.
NEXT_PUBLIC_ADMOB_BANNER_ID=
NEXT_PUBLIC_ADMOB_INTERSTITIAL_ID=
